{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "segments"],
  "properties": {
    "schema_version": {"const": 1},
    "segments": {
      "type": "array",
      "items": {"$ref": "#/$defs/segment"}
    }
  },
  "$defs": {
    "reference_id": {
      "type": "string",
      "pattern": "^(place|stay|food|transport)\\.[a-z0-9][a-z0-9-]*$"
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "ref": {"$ref": "#/$defs/reference_id"},
        "label": {"type": "string", "minLength": 1}
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "provider", "calculated_at", "references"],
      "properties": {
        "method": {"enum": ["chatgpt_research", "routing_api", "mcp", "manual"]},
        "provider": {"type": "string", "minLength": 1},
        "calculated_at": {"type": "string", "format": "date"},
        "references": {
          "type": "array",
          "items": {"type": "string", "format": "uri"}
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "distance_km", "confidence", "note"],
      "properties": {
        "target": {"$ref": "#/$defs/reference_id"},
        "distance_km": {"type": "number", "minimum": 0},
        "additional_distance_km": {"type": "number", "minimum": 0},
        "confidence": {"enum": ["high", "medium", "low"]},
        "note": {"type": "string"}
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "date", "origin", "mode", "route_variant", "display", "calculation", "points"],
      "properties": {
        "id": {"type": "string", "pattern": "^distance\\.[a-z0-9][a-z0-9-]*$"},
        "date": {"type": "string", "format": "date"},
        "origin": {"$ref": "#/$defs/origin"},
        "mode": {"enum": ["self_riding", "walk", "car", "mixed"]},
        "route_variant": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "display": {"type": "boolean"},
        "calculation": {"$ref": "#/$defs/calculation"},
        "points": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/point"}
        }
      }
    }
  }
}
