{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "title", "start_date", "end_date", "origin", "modes"],
  "properties": {
    "schema_version": {"const": 1}, "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "title": {"type": "string", "minLength": 1}, "start_date": {"type": ["string", "null"], "format": "date"},
    "end_date": {"type": ["string", "null"], "format": "date"}, "origin": {"type": ["string", "null"], "minLength": 1},
    "modes": {"type": "array", "uniqueItems": true, "items": {"enum": ["walk", "self_riding", "car", "bus", "train", "ferry", "airplane", "mixed"]}}
  }
}
