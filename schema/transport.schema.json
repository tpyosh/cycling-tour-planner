{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "items"], "properties": {"schema_version": {"const": 1}, "items": {"type": "array", "items": {"$ref": "#/$defs/item"}}},
  "$defs": {"item": {"type": "object", "additionalProperties": false, "required": ["id", "name", "status", "mode", "from", "to", "departure", "arrival", "description"], "properties": {
    "id": {"type": "string", "pattern": "^transport\\.[a-z0-9][a-z0-9-]*$"}, "name": {"type": "string", "minLength": 1}, "status": {"enum": ["discovered", "researching", "shortlisted", "deferred", "rejected"]}, "mode": {"enum": ["bicycle", "train", "ferry", "airplane", "mixed"]},
    "from": {"type": "string"}, "to": {"type": "string"}, "departure": {"type": ["string", "null"], "format": "date-time"}, "arrival": {"type": ["string", "null"], "format": "date-time"}, "description": {"type": "string"}
  }}}
}
