{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": {"const": 1},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "status", "map_query", "description", "tags"],
      "properties": {
        "id": {"type": "string", "pattern": "^place\\.[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["attraction", "hot_spring", "museum", "historic_site", "natural_feature", "transport_site", "town", "other"]},
        "status": {"enum": ["discovered", "researching", "shortlisted", "deferred", "rejected"]},
        "map_query": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}},
        "google_maps": {"$ref": "#/$defs/google_maps"},
        "visit_constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tide_dependent", "official_schedule_required", "weather_dependent", "arrival_margin_minutes", "planning_notes"],
          "properties": {
            "tide_dependent": {"type": "boolean"},
            "official_schedule_required": {"type": "boolean"},
            "weather_dependent": {"type": "boolean"},
            "arrival_margin_minutes": {
              "type": "object",
              "additionalProperties": false,
              "required": ["min", "max"],
              "properties": {"min": {"type": "integer", "minimum": 0}, "max": {"type": "integer", "minimum": 0}}
            },
            "planning_notes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "google_maps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rating", "review_count", "review_count_is_approximate", "checked_at", "source", "evidence_scope", "review_notes", "audience_notes", "evidence_notes", "limitations"],
      "properties": {
        "rating": {"type": ["number", "null"], "minimum": 0, "maximum": 5},
        "review_count": {"type": ["integer", "null"], "minimum": 0},
        "review_count_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": {"type": "integer", "minimum": 0},
            "max": {"type": "integer", "minimum": 0}
          }
        },
        "review_count_is_approximate": {"type": "boolean"},
        "checked_at": {"type": ["string", "null"], "format": "date"},
        "verification_status": {"enum": ["confirmed", "needs_recheck", "unknown"]},
        "acquisition_confidence": {"enum": ["high", "medium", "low", "unknown"]},
        "listing_name": {"type": ["string", "null"], "minLength": 1},
        "subject_match": {"enum": ["exact", "partial", "aggregate", "unknown"]},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "retrieval_method", "url"],
          "properties": {
            "provider": {"const": "Google Maps"},
            "retrieval_method": {"type": "string", "minLength": 1},
            "url": {"type": ["string", "null"], "format": "uri"}
          }
        },
        "evidence_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rating_and_count", "review_text", "photos"],
          "properties": {
            "rating_and_count": {"enum": ["confirmed", "not_confirmed", "unknown"]},
            "review_text": {"enum": ["not_checked", "partial", "extensive", "unknown"]},
            "photos": {"enum": ["not_checked", "partial", "extensive", "unknown"]}
          }
        },
        "genre_context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "cautions"],
          "properties": {
            "category": {"type": "string", "minLength": 1},
            "cautions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "reassessment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "plan_effect", "rationale"],
          "properties": {
            "status": {"enum": ["very_strong", "strong", "adopted", "priority_increased", "recheck_required", "high_priority_recheck", "low_sample", "needs_recheck", "reference_only", "unchanged"]},
            "plan_effect": {"enum": ["maintain", "prioritize_for_comparison", "keep_pending_recheck", "no_downgrade_due_to_missing_data", "reference_only"]},
            "rationale": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "review_notes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "audience_notes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_notes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
