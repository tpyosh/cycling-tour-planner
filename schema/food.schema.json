{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": {"const": 1},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status", "map_query", "area", "description"],
      "properties": {
        "id": {"type": "string", "pattern": "^food\\.[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["discovered", "researching", "shortlisted", "deferred", "rejected"]},
        "map_query": {"type": "string", "minLength": 1},
        "area": {"type": "string", "pattern": "^stay\\."},
        "description": {"type": "string"},
        "google_maps": {"$ref": "#/$defs/google_maps"}
      }
    },
    "google_maps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rating", "review_count", "review_count_is_approximate", "checked_at", "source", "evidence_scope", "review_notes", "audience_notes", "evidence_notes", "limitations"],
      "properties": {
        "rating": {"type": ["number", "null"], "minimum": 0, "maximum": 5},
        "review_count": {"type": ["integer", "null"], "minimum": 0},
        "review_count_is_approximate": {"type": "boolean"},
        "checked_at": {"type": ["string", "null"], "format": "date"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "retrieval_method", "url"],
          "properties": {
            "provider": {"const": "Google Maps"},
            "retrieval_method": {"type": "string", "minLength": 1},
            "url": {"type": ["string", "null"], "format": "uri"}
          }
        },
        "evidence_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rating_and_count", "review_text", "photos"],
          "properties": {
            "rating_and_count": {"enum": ["confirmed", "not_confirmed", "unknown"]},
            "review_text": {"enum": ["not_checked", "partial", "extensive", "unknown"]},
            "photos": {"enum": ["not_checked", "partial", "extensive", "unknown"]}
          }
        },
        "review_notes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "audience_notes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_notes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
