{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "status", "recommendations", "weather_climate", "days", "contingencies"], "properties": {"schema_version": {"const": 1}, "status": {"const": "working"}, "recommendations": {"type": "array", "items": {"type": "string", "minLength": 1}}, "weather_climate": {"$ref": "#/$defs/weather_climate"}, "days": {"type": "array", "items": {"$ref": "#/$defs/day"}}, "contingencies": {"type": "array", "items": {"$ref": "#/$defs/contingency"}}},
  "$defs": {"ids": {"type": "array", "items": {"type": "string", "pattern": "^(place|route|stay|food|transport)\\.[a-z0-9][a-z0-9-]*$"}}, "transport_ids": {"type": "array", "items": {"type": "string", "pattern": "^transport\\.[a-z0-9][a-z0-9-]*$"}},
  "distance": {"type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": {"min": {"type": "number", "minimum": 0}, "max": {"type": "number", "minimum": 0}}},
  "source": {"type": "object", "additionalProperties": false, "required": ["title", "url", "checked_at", "volatility"], "properties": {"title": {"type": "string", "minLength": 1}, "url": {"type": "string", "format": "uri"}, "checked_at": {"type": "string", "format": "date"}, "volatility": {"enum": ["low", "medium", "high"]}}},
  "weather_claim": {"type": "object", "additionalProperties": false, "required": ["kind", "text"], "properties": {"kind": {"enum": ["fact", "inference", "unverified"]}, "text": {"type": "string", "minLength": 1}}},
  "forecast_day": {"type": "object", "additionalProperties": false, "required": ["date", "route_label", "facts", "interpretation", "recheck_focus"], "properties": {"date": {"type": "string", "format": "date"}, "route_label": {"type": "string", "minLength": 1}, "facts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "interpretation": {"type": "array", "items": {"type": "string", "minLength": 1}}, "recheck_focus": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
  "climate_station": {"type": "object", "additionalProperties": false, "required": ["name", "values", "interpretation"], "properties": {"name": {"type": "string", "minLength": 1}, "values": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "interpretation": {"type": "string", "minLength": 1}}},
  "weather_climate": {"type": "object", "additionalProperties": false, "required": ["forecast_snapshot", "climate_baseline", "seasonal_outlook", "operational_summary", "update_policy"], "properties": {
    "forecast_snapshot": {"type": "object", "additionalProperties": false, "required": ["retrieved_at", "sources", "synoptic_context", "days"], "properties": {"retrieved_at": {"type": "string", "format": "date-time"}, "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}, "synoptic_context": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/weather_claim"}}, "days": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/forecast_day"}}}},
    "climate_baseline": {"type": "object", "additionalProperties": false, "required": ["period", "sources", "stations", "interpretation"], "properties": {"period": {"type": "string", "pattern": "^\\d{4}[–-]\\d{4}$"}, "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}, "stations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/climate_station"}}, "interpretation": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "seasonal_outlook": {"type": "object", "additionalProperties": false, "required": ["issued_at", "sources", "claims", "application"], "properties": {"issued_at": {"type": "string", "format": "date"}, "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}, "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/weather_claim"}}, "application": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "operational_summary": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "update_policy": {"type": "string", "minLength": 1}
  }},
  "contingency": {"type": "object", "additionalProperties": false, "required": ["id", "name", "trigger", "date", "transport", "transport_alternatives", "impacts", "unresolved"], "properties": {"id": {"type": "string", "pattern": "^contingency\\.[a-z0-9][a-z0-9-]*$"}, "name": {"type": "string", "minLength": 1}, "trigger": {"type": "string", "minLength": 1}, "date": {"type": "string", "format": "date"}, "transport": {"$ref": "#/$defs/transport_ids"}, "transport_alternatives": {"$ref": "#/$defs/transport_ids"}, "impacts": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "unresolved": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
  "day": {"type": "object", "additionalProperties": false, "required": ["date", "start", "finish", "self_riding", "routes", "transport", "transport_alternatives", "visits", "optional_visits", "food", "stay", "notes"], "properties": {
    "date": {"type": "string", "format": "date"}, "start": {"type": "string", "minLength": 1}, "finish": {"type": "string", "minLength": 1},
    "self_riding": {"type": "object", "additionalProperties": false, "required": ["distance_km"], "properties": {"distance_km": {"$ref": "#/$defs/distance"}}},
    "routes": {"$ref": "#/$defs/ids"}, "transport": {"$ref": "#/$defs/ids"}, "transport_alternatives": {"$ref": "#/$defs/transport_ids"}, "visits": {"$ref": "#/$defs/ids"}, "optional_visits": {"$ref": "#/$defs/ids"}, "food": {"$ref": "#/$defs/ids"},
    "stay": {"type": "object", "additionalProperties": false, "required": ["preferred", "fallback"], "properties": {"preferred": {"$ref": "#/$defs/ids"}, "fallback": {"$ref": "#/$defs/ids"}}}, "notes": {"type": "array", "items": {"type": "string"}}
  }}}
}
