{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "actions"],
  "properties": {
    "schema_version": {"const": 1},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}}
  },
  "$defs": {
    "action": {"type": "object", "additionalProperties": false,
      "required": ["id", "action", "timing", "deadline", "why_it_matters", "dependencies", "related_issues", "related_subjects", "evidence", "notes"],
      "properties": {
        "id": {"type": "string", "pattern": "^action\\.[a-z0-9][a-z0-9-]*$"},
        "action": {"type": "string", "minLength": 1},
        "timing": {"enum": ["do_now", "after_decision", "before_departure", "day_before", "same_day", "blocked"]},
        "deadline": {"type": ["string", "null"], "format": "date"},
        "why_it_matters": {"type": "string", "minLength": 1},
        "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^(issue|action)\\.[a-z0-9][a-z0-9-]*$"}, "uniqueItems": true},
        "related_issues": {"type": "array", "items": {"type": "string", "pattern": "^issue\\.[a-z0-9][a-z0-9-]*$"}, "uniqueItems": true},
        "related_subjects": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(place|route|stay|food|transport)\\.[a-z0-9][a-z0-9-]*$"}, "uniqueItems": true},
        "evidence": {"type": "array", "items": {"type": "string", "pattern": "^evidence\\.[a-z0-9][a-z0-9-]*$"}, "uniqueItems": true},
        "notes": {"type": "string", "minLength": 1}
      }
    }
  }
}
