{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "items"], "properties": {"schema_version": {"const": 1}, "items": {"type": "array", "items": {"$ref": "#/$defs/item"}}},
  "$defs": {"item": {"type": "object", "additionalProperties": false, "required": ["id", "subject", "checked_at", "claims", "volatility", "recheck_before_trip", "source"], "properties": {
    "id": {"type": "string", "pattern": "^evidence\\.[a-z0-9][a-z0-9-]*$"}, "subject": {"type": "string", "pattern": "^(place|route|stay|food|transport)\\."}, "checked_at": {"type": ["string", "null"], "format": "date"},
    "claims": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "volatility": {"enum": ["low", "medium", "high"]}, "recheck_before_trip": {"type": "boolean"},
    "source": {"type": "object", "additionalProperties": false, "required": ["type", "url"], "properties": {"type": {"type": "string"}, "url": {"type": ["string", "null"], "format": "uri"}}}
  }}}
}
